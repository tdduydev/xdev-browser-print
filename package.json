{
  "name": "xdev-browser-print-monorepo",
  "private": true,
  "version": "0.3.3",
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck && tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "pnpm --filter @tdduydev/browser-print build && pnpm --filter @xdev/react-demo build && pnpm --filter @xdev/browser-print-extension build:e2e && playwright test",
    "package": "node scripts/package-extension.mjs",
    "release": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm package",
    "check:sdk-package": "node scripts/check-sdk-package.mjs",
    "showcase": "pnpm --filter @tdduydev/browser-print build && pnpm --filter @xdev/react-demo build && pnpm --filter @xdev/browser-print-extension build:e2e && node scripts/showcase.mjs",
    "cws:screenshots": "pnpm --filter @xdev/browser-print-extension build && node scripts/cws-screenshots.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.0",
    "@types/chrome": "0.1.43",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.5.0",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vitest": "3.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
