{
  "name": "@tdduydev/browser-print",
  "version": "0.3.1",
  "description": "TypeScript SDK for web apps to print through the xDev Browser Print Chrome extension.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@xdev/core": "workspace:*",
    "@xdev/shared-types": "workspace:*",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsup": "8.5.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tdduydev/xdev-browser-print.git",
    "directory": "packages/browser-print-sdk"
  }
}
